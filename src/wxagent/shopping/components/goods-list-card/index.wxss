.card {
  box-sizing: border-box;
  width: 100%;
  padding: 24px;
  background: #ffffff;
  border-radius: 24px;
}
.hd {
  font-size: 28px;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20px;
}
.list {
  display: flex;
  flex-direction: column;
}
.row {
  display: flex;
  align-items: center;
  padding: 16px 0;
  border-bottom: 1px solid #f2f2f2;
}
.pic {
  width: 120px;
  height: 120px;
  border-radius: 16px;
  background: #f5f5f5;
  flex-shrink: 0;
}
.info {
  flex: 1;
  margin-left: 20px;
  min-width: 0;
}
.title {
  font-size: 28px;
  color: #1a1a1a;
  line-height: 38px;
  max-height: 76px;
  overflow: hidden;
}
.price {
  margin-top: 12px;
  font-size: 32px;
  font-weight: 600;
  color: #ff4d31;
}
.price .cur {
  font-size: 24px;
}
