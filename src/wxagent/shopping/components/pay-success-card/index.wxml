<view class="ps-card">
  <view class="ps-badge"><text class="ps-check">✓</text></view>
  <view class="ps-title">支付成功</view>
  <view class="ps-amount" wx:if="{{paidAmount != null}}">¥{{paidAmount}}</view>
  <view class="ps-info">
    <view class="ps-row">
      <text class="ps-label">订单号</text>
      <text class="ps-value">{{orderId}}</text>
    </view>
    <view class="ps-row" wx:if="{{payTimeText}}">
      <text class="ps-label">支付时间</text>
      <text class="ps-value">{{payTimeText}}</text>
    </view>
  </view>
  <view class="ps-tip">支付成功，商家将尽快为您发货</view>
</view>
