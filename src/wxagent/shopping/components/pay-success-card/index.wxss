.ps-card {
  box-sizing: border-box;
  width: 100%;
  padding: 40px 24px;
  background: #ffffff;
  border-radius: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ps-badge {
  width: 96px;
  height: 96px;
  border-radius: 48px;
  background: #07c160;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ps-check {
  color: #ffffff;
  font-size: 56px;
  font-weight: 700;
}
.ps-title {
  margin-top: 24px;
  font-size: 32px;
  font-weight: 600;
  color: #1a1a1a;
}
.ps-amount {
  margin-top: 12px;
  font-size: 48px;
  font-weight: 700;
  color: #1a1a1a;
}
.ps-info {
  width: 100%;
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1px solid #f2f2f2;
}
.ps-row {
  display: flex;
  justify-content: space-between;
  margin-top: 16px;
}
.ps-label {
  font-size: 26px;
  color: #999999;
}
.ps-value {
  font-size: 26px;
  color: #1a1a1a;
}
.ps-tip {
  margin-top: 32px;
  font-size: 24px;
  color: #999999;
  text-align: center;
}
