.card {
  box-sizing: border-box;
  width: 100%;
  padding: 24px;
  background: #ffffff;
  border-radius: 24px;
}
.goods {
  display: flex;
}
.pic {
  width: 140px;
  height: 140px;
  border-radius: 16px;
  background: #f5f5f5;
  flex-shrink: 0;
}
.info {
  flex: 1;
  margin-left: 24px;
  min-width: 0;
}
.title {
  font-size: 28px;
  color: #1a1a1a;
  line-height: 40px;
  max-height: 80px;
  overflow: hidden;
}
.meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 20px;
}
.price {
  font-size: 32px;
  font-weight: 600;
  color: #ff4d31;
}
.num {
  font-size: 26px;
  color: #999999;
}
.addr {
  margin-top: 20px;
  font-size: 26px;
  color: #666666;
  line-height: 36px;
}
.foot {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid #f2f2f2;
}
.total {
  font-size: 28px;
  color: #1a1a1a;
  text-align: right;
}
.amount {
  font-size: 36px;
  font-weight: 700;
  color: #ff4d31;
}
.btn {
  margin-top: 20px;
  height: 80px;
  line-height: 80px;
  text-align: center;
  font-size: 30px;
  font-weight: 600;
  color: #ffffff;
  background: #ff4d31;
  border-radius: 40px;
}
