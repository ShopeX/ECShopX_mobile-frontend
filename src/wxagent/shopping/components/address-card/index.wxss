.card {
  box-sizing: border-box;
  width: 100%;
  padding: 24px;
  background: #ffffff;
  border-radius: 24px;
}
.hd {
  font-size: 28px;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16px;
}
.row {
  padding: 20px 0;
  border-bottom: 1px solid #f2f2f2;
}
.line1 {
  display: flex;
  align-items: center;
}
.name {
  font-size: 30px;
  font-weight: 600;
  color: #1a1a1a;
}
.mobile {
  margin-left: 20px;
  font-size: 28px;
  color: #666666;
}
.tag {
  margin-left: 16px;
  padding: 0 12px;
  height: 36px;
  line-height: 36px;
  font-size: 22px;
  color: #ff4d31;
  border: 1px solid #ff4d31;
  border-radius: 18px;
}
.line2 {
  margin-top: 12px;
  font-size: 26px;
  color: #666666;
  line-height: 36px;
}
