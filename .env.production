# ---------- AI 助手（与 src/utils/ai-assistant-embed.js、ai-assistant-fab 一致）----------
# 总开关：1 / true 才渲染挂件
APP_AI_ASSISTANT=1
# 助手服务根 URL（无尾斜杠），用于默认嵌入页与 widget；与商城 API 域名可不同
APP_AI_BASE_URL=http://assistant.test/
# 租户 ID（助手侧多租户）
APP_AI_TENANT_ID=c6bb2814299811f1bef19352e276a9ec

# 嵌入页完整 URL（指向 index.html）。留空则依次用：APP_AI_BASE_URL/.../index.html → APP_CUSTOM_SERVER → 从 APP_BASE_URL 推导的 H5 源站 + ai-assistant-embed/
APP_AI_EMBED_PAGE_URL=
# H5 漂浮挂件脚本 URL。留空则用同源 /ai-assistant-embed/widget-h5.js（src/files/ai-assistant-embed/widget-h5.js 由构建拷入 H5 dist 根，避开脚本加载 CORS）
APP_AI_WIDGET_SCRIPT_URL=
# 挂件 / web-view 内请求的后端根 URL（无尾斜杠）。留空则等于 APP_AI_BASE_URL；本地直连 Java 助手时可写 http://localhost:9020
APP_AI_ASSISTANT_BACKEND_URL=http://assistant.test
# 微信小程序 web-view：嵌入页为 http 时须为 1（仅开发）；正式环境请 https 并勿依赖此项
APP_AI_WEBVIEW_ALLOW_HTTP=1
# 微信小程序：1 / true 时用旧版「应用内简易对话」挂件；留空或 0 则用侧吸钮 + 独立页 web-view 加载嵌入页（推荐）
APP_AI_MINIPROGRAM_LEGACY=

