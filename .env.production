# ---------- AI 助手（与 src/utils/ai-assistant-embed.js、ai-assistant-fab 一致）----------
# 总开关：必须为 1 才渲染挂件
APP_AI_ASSISTANT=1
# 助手服务根 URL（无尾斜杠），用于默认嵌入页；与商城 API 域名可不同
APP_AI_BASE_URL=https://ai-assistant.shopexai.com/
# 租户 ID（助手侧多租户）
APP_AI_TENANT_ID=2dde541b38a511f1929d0242ac170002

# 嵌入页完整 URL（指向 index.html）。留空则依次用：APP_AI_BASE_URL/.../index.html → APP_CUSTOM_SERVER → 从 APP_BASE_URL 推导的 H5 源站 + ai-assistant-embed/
APP_AI_EMBED_PAGE_URL=https://ai-assistantapi.shopexai.com/ai-assistant-embed/index.html
# 挂件 / web-view 内请求的后端根 URL（无尾斜杠）。留空则等于 APP_AI_BASE_URL；本地直连 Java 助手时可写 http://localhost:9020
APP_AI_ASSISTANT_BACKEND_URL=https://ai-assistantapi.shopexai.com
